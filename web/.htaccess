# Caching rules live here, in the repo, not in hPanel.
# Pages, code and scan data: the browser revalidates every time (a cheap 304 when unchanged).
# Fonts and images: cached for a year. Their filenames carry a version or a content hash.
# Icons carry a version in their names (favicon-v1.svg), so they can be cached for a year.
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|jpg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
